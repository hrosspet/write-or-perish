{
  "manifest_version": 3,
  "name": "Loore Clipper",
  "version": "0.1.0",
  "description": "Save the current tab into your Loore references with one key press, then close it.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://loore.org/*",
    "https://staging.loore.org/*",
    "http://localhost:3001/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Loore Clipper",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "commands": {
    "clip-and-close": {
      "suggested_key": { "default": "Alt+Shift+L", "mac": "Alt+Shift+L" },
      "description": "Clip this tab into Loore and close it"
    },
    "clip-and-keep": {
      "suggested_key": { "default": "Alt+Shift+K", "mac": "Alt+Shift+K" },
      "description": "Clip this tab into Loore and keep it open"
    }
  }
}
