[Unit]
Description=Write or Perish Celery Worker (background queue)
After=network.target redis-server.service postgresql.service
Requires=redis-server.service

# Queue split (#379): the work nobody waits for (profile builds, imports,
# digests, batch polls, syncs, sweeps, purges; backend/celery_queues.py),
# plus the default queue "celery": Celery's own tasks, messages queued
# before the switch, and their retries. Together with
# write-or-perish-celery-interactive.service it replaces
# write-or-perish-celery.service. deploy.sh never installs this file; once
# the unit is enabled, it keeps it current and restarts it. Switching on
# and off: docs/RUNBOOKS.md → "Celery queue split".

[Service]
Type=forking
User=hrosspet
Group=hrosspet
WorkingDirectory=/home/hrosspet/write-or-perish
EnvironmentFile=/home/hrosspet/write-or-perish/.env.production
PIDFile=/home/hrosspet/write-or-perish/celery-background.pid

# -n: two workers on one machine need different node names. %%h reaches
# Celery as %h, the hostname (systemd would expand a single %h itself).
ExecStart=/bin/bash -c 'source ~/miniconda3/etc/profile.d/conda.sh && conda activate write-or-perish && celery -A backend.celery_app:celery worker -Q background,celery -n background@%%h --loglevel=info --logfile=/home/hrosspet/write-or-perish/logs/celery-background.log --pidfile=/home/hrosspet/write-or-perish/celery-background.pid --detach --concurrency=2'

ExecReload=/bin/kill -s HUP $MAINPID

# The same warm shutdown as the interactive worker (#312), with a 5-minute
# drain (maintainer's call, 2026-11-09): replies don't wait behind this
# worker, so a running import or profile render gets time to finish. A job
# still running after the drain is cut off. TimeoutStopSec leaves 2 minutes
# after the drain for the pool processes to stop before systemd's SIGKILL.
ExecStop=/bin/bash /home/hrosspet/write-or-perish/scripts/celery-graceful-stop.sh $MAINPID 300
KillMode=mixed
TimeoutStopSec=420

# The site and the interactive worker get the CPU first when both need
# it (the backup service uses the same value).
Nice=10

# Memory limit (#613). A job that takes this worker past MemoryMax is
# killed inside it instead of taking memory from the site, Postgres and
# Redis: the kernel's OOM killer kills a pool process (the one running the
# job; backend/utils/worker_oom.py), the main process logs the lost task
# and starts a new pool process, and OOMPolicy=continue keeps systemd from
# stopping the unit. MemorySwapMax=0: on a server with swap the job is
# killed too, not moved to swap. No MemoryHigh: without swap it does not
# free memory, it only holds a job that grows past it in a slow crawl for
# minutes before the kill, with every process of the unit slowed down
# (docs/RUNBOOKS.md → "Memory limits"). Room for the main process, the
# pool processes and one heavy job (backend/utils/heavy_slot.py runs them
# one at a time). Sized for the production host; adjust with a systemd
# drop-in (docs/RUNBOOKS.md → "Celery queue split" → "Memory limits"),
# which deploys do not overwrite.
MemoryAccounting=yes
MemoryMax=1152M
MemorySwapMax=0
OOMPolicy=continue

Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
